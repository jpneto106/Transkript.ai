<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Casca nativa do Transkript.ai.

    Uma janela do Windows que hospeda a interface web (WebView2) e sobe o
    servidor Python como processo filho. Substitui a janela do Edge em modo
    aplicativo: ícone próprio na barra de tarefas e sem depender de navegador.

    Para publicar autossuficiente (não exige runtime na máquina do usuário),
    veja o comando em LEIAME_CASCA.md, nesta mesma pasta.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>Transkript.ai</AssemblyName>
    <RootNamespace>Transkript</RootNamespace>
    <ApplicationIcon>..\app.ico</ApplicationIcon>

    <Product>Transkript.ai</Product>
    <Company>JP.Neto</Company>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>

    <!-- Só português: evita dezenas de pastas de tradução do WebView2 na saída. -->
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>

    <!--
      O pacote do WebView2 traz junto a versão para WPF, que não usamos. Ela
      gera um aviso inofensivo de conflito no WindowsBase. Rebaixado a mensagem
      para o log de compilação ficar legível.
    -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>

    <!--
      Casca ainda compila com 111 MB no .NET 10 porque Windows Forms + trim
      completo bate em NETSDK1175. Marcamos a propriedade como experimental
      e desligamos o que dá pra desligar sem refatorar a casca: o resto da
      redução virá na Etapa 3 do plano (reescrita opcional em Rust/Win32).

      O ganho aqui é modesto mas de risco zero: tirar globalization (o
      programa já é pt-BR fixo via `SatelliteResourceLanguages`) e stack
      traces ricos (o usuário final não vê a profundidade do .NET) costuma
      economizar 10–15 MB sem mudar o comportamento visível.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);IL2026;IL3050;NETSDK1130</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
  </ItemGroup>

</Project>
